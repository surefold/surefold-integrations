    <url>https://github.com/surefold/surefold-integrations</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>dev.surefold</groupId>
      <artifactId>surefold-cluster</artifactId>
      <version>0.18.1</version>
      <scope>compile</scope>
